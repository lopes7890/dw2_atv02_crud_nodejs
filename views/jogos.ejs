<%- include ('partials/header.ejs') %>

<%- include ('partials/navbar.ejs') %>

<div class="container" style="margin-top: 20px;">
    <div class="card">
        <div class="card-header">
            <h1>Cadastrar Jogo</h1>
        </div>
    
    <div class="card-body">
        <form action="/jogos/cadastrar" method="post">
            <label for="nome">Nome do Jogo</label>
            <input type="text" id="nome" name="nome" placeholder="Digite o nome do jogo" class="form-control" required>

            <label for="descricao">Descrição</label>
            <input type="text" id="descricao" name="descricao" placeholder="Digite a descrição do jogo" class="form-control" required>

            <label for="preco">Preço</label>
            <input type="number" id="preco" name="preco" placeholder="Digite o preço do jogo" class="form-control" required>

            <label for="categoria">Categoria</label>
            <input type="text" id="categoria" name="categoria" placeholder="Digite a categoria do jogo" class="form-control" required>
        
            <br>
            <button type="submit" class="btn btn-success">Cadastrar</button>
            <button type="reset" class="btn btn-danger">Limpar</button>
        </form>
    </div>

    </div>

</div>

<table>
    <tr>
        <th>Jogo</th>
        <!-- <th>Preço</th> -->
        <!-- <th>Descrição</th>
        <th>Categoria</th> -->
        <th style="text-align: center;" colspan="2">Ações</th>
    </tr>

    <% jogos.forEach(jogo => { %>
    <tr>
        <td><%= jogo.nome %></td>
        <!-- <td><%= jogo.descricao %></td>
        <td><%= jogo.categoria %></td> -->
        <td>
            <a href="/jogos/editar/<%= jogo.id %>" class="btn btn-warning">Editar</a>
        </td>
        <td>
            <a href="/jogos/excluir/<%= jogo.id %>" onclick="return confirm('Deseja mesmo excluir o jogo <% jogo.nome %>')" class="btn btn-danger">Excluir</a>
        </td>
    </tr>

    <%}) %>
    
</table>


<%- include ('partials/footer.ejs') %>