<%- include ('partials/header.ejs') %>

<%- include ('partials/navbar.ejs') %>

<div class="container" style="margin-top: 20px;">
    <div class="card">
        <div class="card-header">
            <h1>Editar Jogo</h1>
        </div>
        <div class="card-body">
            <form action="/jogos/alterar" method="post">
                <label for="nome">Nome do Jogo</label>
                <input type="text" name="nome" id="nome" class="form-control" required value="<%= jogo.nome %>">
                <label for="preco">Preço do Jogo</label>
                <input type="number" name="preco" id="preco" class="form-control" required value="<%= jogo.preco %>">
                <label for="descricao">Descrição do Jogo</label>
                <input type="text" name="descricao" id="descricao" class="form-control" required value="<%= jogo.descricao %>">
                <label for="categoria">Categoria do Jogo</label>
                <input type="text" name="categoria" id="categoria" class="form-control" required value="<%= jogo.categoria %>">

                <input type="hidden" name="id" id="id" value="<%= jogo.id %>">
                <br>
                <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o jogo <% jogo.nome %>')">Alterar</button>
                <a href="/jogos"><button type="button" class="btn btn-danger">Cancelar</button></a>
            </form>
        </div>
    </div>
</div>


<%- include ('partials/footer.ejs') %>